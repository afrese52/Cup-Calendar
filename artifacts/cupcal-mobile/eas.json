{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "cupcal.af-software.app"
      },
      "node": "22.13.0",
      "pnpm": "10.26.1",
      "credentialsSource": "remote",
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-58",
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "preview",
      "environment": "preview",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      }
    }
  }
}
