{
  "expo": {
    "name": "CupCal: Kalender für FN",
    "slug": "cupcol-for-fn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cupcal-android",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090e17"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.cupcal.android",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#090e17"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CupCal nutzt deinen Standort nur zur Auswahl der nächstgelegenen Fortnite-Turnierregion. Standortkoordinaten werden nicht gespeichert oder gesendet.",
          "isIosReducedAccuracyByDefault": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "112401ab-4241-4e9c-b7c8-857b508ceb05"
      }
    }
  }
}
