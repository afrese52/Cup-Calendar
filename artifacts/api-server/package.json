{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dry-run:mht": "node ./scripts/run-dry-run-mht-import.mjs",
    "test:mht-import": "node --test ./scripts/dry-run-mht-import.test.mjs",
    "test:bookmark-isolation": "node --test ./scripts/bookmark-account-isolation.test.mjs",
    "test:bookmark-concurrency": "node --test --test-name-pattern='gleichzeitige RPC-Aufrufe' ./scripts/bookmark-account-isolation.test.mjs",
    "test:bookmark-migration": "node --test ./scripts/bookmark-migration.test.mjs",
    "test:supabase-migrations:fresh": "node --test ./scripts/supabase-migrations-fresh.test.mjs",
    "test:send-email-hook": "node --experimental-strip-types --test ./src/services/authEmailHook.test.mjs",
    "test:admin-import": "node --experimental-strip-types --test ./src/services/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "nodemailer": "^10.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "standardwebhooks": "^1.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "8.23.1",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0"
  }
}
